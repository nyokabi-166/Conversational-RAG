# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Application Environment
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO

# Authentication (set a unique secret of at least 32 characters outside development)
# JWT_SECRET_KEY=

# LLM Providers (Configure whichever you use)
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL 15.4 Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airline_rag
DATABASE_URL=postgresql://postgres:postgres@db:5432/airline_rag

# ChromaDB Configuration
CHROMA_HOST=chroma
CHROMA_PORT=8000

# External Model APIs (Required by Capstone)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# OpenSky Network API (Optional for live flight tracking)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
