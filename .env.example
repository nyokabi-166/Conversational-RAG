# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Application Environment
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# Authentication (set a unique secret of at least 32 characters outside development)
# JWT_SECRET_KEY=
# One-time first-administrator setup secret; remove it after creating the first admin.
# ADMIN_SETUP_TOKEN=

# LLM providers (backend only; do not expose these in frontend variables)
# OpenRouter is the primary generation provider.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Set this to the exact model route selected for the project and evaluation.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Manual backup only: set LLM_PROVIDER=deepinfra and provide these values if needed.
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# PostgreSQL 15.4 Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airline_rag
DATABASE_URL=postgresql://postgres:postgres@db:5432/airline_rag

# ChromaDB Configuration
CHROMA_HOST=chroma
CHROMA_PORT=8000

# External Model APIs (Required by Capstone)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
# Use https://api.amadeus.com only after production access is approved.
AMADEUS_API_URL=https://test.api.amadeus.com
AVIATIONSTACK_ACCESS_KEY=your_aviationstack_access_key_here
# Flight-data credentials stay on the backend; never expose them with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_TESTSET_MODEL=gemini-3.8-flash

# OpenSky Network API (Optional for live flight tracking)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Email Notification Dispatcher (For Trip Alerts & Proactive Reminders)
# Option A: Resend (Recommended: free 3,000 emails/month at https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Kenya Airways Assistant <onboarding@resend.dev>

# Option B: Standard SMTP (Optional alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH0_DOMAIN=your-tenant.us.auth0.com
